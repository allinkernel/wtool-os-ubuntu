<?xml version="1.0" encoding="UTF-8"?>
<!--
  迁移自 mytool/os（原 wsw_os_config）。新方案分两件事：

  1. system-file kind="apt-mirror"：换源。
     引擎读 /etc/os-release 自动识别发行版与 codename，生成 deb822 内容，
     写到 /etc/apt/sources.list.d/ubuntu.sources；写前备份，卸载时自动还原。
     （旧版是 10 个静态 sources.list 文件加手工 cp，已废弃）

  2. provision（ansible）：装基础软件包。
     幂等、可重跑，不进 install 的 journal（apt 包删掉即可，不需要回退）。

  priority=5：最早执行，保证后面编译型项目有编译器和依赖。
  需要 root：执行 provision 时带上 with-system 参数
-->
<wtool schema="1" id="os/ubuntu" priority="5">

  <!-- 换源：mirror="auto" = **听 install.sh 的**。
       install.sh 第 0 步会测速、让你挑一个，并把选择记在 <state>/mirror.txt；
       这里就照它来（已经换过就跳过，不再写第二份源文件 —— 两份源文件会让
       apt 警告 "configured multiple times"，装包任务会失败）。
       想固定用某一个镜像，就把 auto 换成 ustc / tuna / aliyun / huawei / netease / tencent。
       详见 harness/docs/adr/0032-one-place-configures-apt-mirror.md -->
  <sudo-install kind="apt-mirror" mirror="auto" dest="auto"
                mode="replace" backup="true"
                when="os:ubuntu"
                desc="apt 源（跟随 install.sh 里挑的那个镜像）"/>

  <!-- 基础包：让 shell 环境能跑起来（zsh/tmux/vim/ripgrep/常用工具） -->
  <sudo-install src="provision/packages.yaml" marker="apt-base"
                when="os:ubuntu" desc="基础软件包（常用工具 + 搜索 + 构建基础）"/>

  <!-- 重型工具链（clang/llvm/gcc/gdb/emacs，1GB+）：设 WTOOL_HEAVY=1 才装 -->
  <sudo-install src="provision/toolchain.yaml" marker="apt-toolchain"
                when="os:ubuntu,env:WTOOL_HEAVY"
                desc="重型工具链（需要 WTOOL_HEAVY=1）"/>

</wtool>
